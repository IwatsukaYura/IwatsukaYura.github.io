{{- $index := slice -}}
{{- range where site.RegularPages "Type" "in" site.Params.mainSections -}}
  {{- if not .Params.searchHidden -}}
    {{- $tags := slice -}}
    {{- range .GetTerms "tags" }}{{ $tags = $tags | append .LinkTitle }}{{ end -}}
    {{- $index = $index | append (dict
        "title" .Title
        "permalink" (.Params.externalUrl | default .RelPermalink)
        "external" (ne .Params.externalUrl nil)
        "source" (.Params.source | default "")
        "date" (.Date.Format "2006.01.02")
        "readingTime" (cond (lt .ReadingTime 1) 1 .ReadingTime)
        "tags" $tags
        "summary" (.Summary | plainify | htmlUnescape | chomp)
        "content" (.Plain | htmlUnescape | truncate 6000)
      ) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
